{
  "name": "ventropos-backend",
  "version": "1.0.0",
  "description": "VentroPos - Point of Sale Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "pg": "^8.12.0",
    "knex": "^3.1.0",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "uuid": "^10.0.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.6",
    "@types/bcrypt": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.5",
    "vitest": "^2.0.4",
    "@vitest/coverage-v8": "^2.0.4",
    "eslint": "^9.7.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint-plugin-fastify": "^4.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
